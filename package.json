{
  "name": "aurevix-hms",
  "version": "1.0.0",
  "private": true,
  "description": "Aurevix Hospital Management System — Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "seed": "pnpm --filter @aurevix/api run seed",
    "db:migrate": "pnpm --filter @aurevix/api run db:migrate",
    "db:generate": "pnpm --filter @aurevix/api run db:generate",
    "db:studio": "pnpm --filter @aurevix/api run db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.13.1"
}
