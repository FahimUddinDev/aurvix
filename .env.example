# =============================================================================
# AUREVIX HMS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://aurevix:aurevix_pass@localhost:5432/aurevix_hms?schema=public"
DATABASE_URL_TEST="postgresql://aurevix:aurevix_pass@localhost:5432/aurevix_hms_test?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=aurevix-hms

# ─── NestJS API ──────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000

# ─── Next.js Web ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── SSL Wireless (SMS) ──────────────────────────────────────────────────────
SSL_WIRELESS_API_TOKEN=your_api_token
SSL_WIRELESS_SENDER_ID=AUREVIX
SSL_WIRELESS_API_URL=https://api.sslwireless.com/api/v1/send

# ─── SSLCommerz ──────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:4000/payment/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:4000/payment/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:4000/payment/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:4000/payment/sslcommerz/ipn

# ─── bKash ───────────────────────────────────────────────────────────────────
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password
BKASH_IS_SANDBOX=true

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Aurevix HMS <noreply@aurevix.com>"

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=your_super_secret_session_key_min_32_chars
SESSION_IDLE_TIMEOUT_MS=900000

# ─── pgcrypto / Encryption ───────────────────────────────────────────────────
PGCRYPTO_KEY=your_pgcrypto_encryption_key

# ─── Throttler (Rate Limiting) ───────────────────────────────────────────────
THROTTLER_TTL=60
THROTTLER_LIMIT=100
AUTH_THROTTLER_TTL=60
AUTH_THROTTLER_LIMIT=5
