// ═══════════════════════════════════════════════════════════════════════════
// BLOOD BANK
// ═══════════════════════════════════════════════════════════════════════════

model BloodDonor {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId  String     @db.Uuid
  name        String
  phone       String
  bloodGroup  BloodGroup
  dateOfBirth DateTime?
  address     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?

  hospital Hospital    @relation(fields: [hospitalId], references: [id])
  units    BloodUnit[]

  @@map("blood_donors")
}

model BloodUnit {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId      String          @db.Uuid
  donorId         String          @db.Uuid
  bloodGroup      BloodGroup
  unitCode        String          @unique
  collectedAt     DateTime
  expiryAt        DateTime
  volumeMl        Int             @default(450)
  status          BloodUnitStatus @default(AVAILABLE)
  screeningPassed Boolean         @default(false)
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?
  updatedBy       String?

  donor        BloodDonor         @relation(fields: [donorId], references: [id])
  crossMatches CrossMatchResult[]

  @@index([bloodGroup])
  @@index([status])
  @@map("blood_units")
}

model BloodRequest {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId  String     @db.Uuid
  patientId   String     @db.Uuid
  bloodGroup  BloodGroup
  units       Int
  urgency     String     @default("ROUTINE") // ROUTINE, URGENT, EMERGENCY
  status      String     @default("PENDING") // PENDING, FULFILLED, CANCELLED
  requestedAt DateTime   @default(now())
  fulfilledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?

  crossMatches CrossMatchResult[]

  @@map("blood_requests")
}

model CrossMatchResult {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId   String    @db.Uuid
  unitId       String    @db.Uuid
  requestId    String    @db.Uuid
  isCompatible Boolean
  testedBy     String?   @db.Uuid
  testedAt     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  unit    BloodUnit    @relation(fields: [unitId], references: [id])
  request BloodRequest @relation(fields: [requestId], references: [id])

  @@map("cross_match_results")
}

