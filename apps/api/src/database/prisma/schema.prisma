// ============================================================================
// Aurevix HMS — Full Prisma Schema
// Rules: UUID v7 PKs, hospitalId on all tenant tables,
//        createdAt/updatedAt/createdBy/updatedBy on every model,
//        NID encrypted via pgcrypto (handled at application layer),
//        NO insurance/TPA content.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  SCHEDULED
  WALK_IN
  EMERGENCY
  FOLLOW_UP
  TELEMEDICINE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  UNDER_CLEANING
  OUT_OF_SERVICE
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
  ABSCONDED
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  SSLCOMMERZ
  BKASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  RESULTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ResultFlag {
  NORMAL
  ABNORMAL
  CRITICAL_HIGH
  CRITICAL_LOW
}

enum RadiologyOrderStatus {
  PENDING
  IN_PROGRESS
  REPORT_UPLOADED
  APPROVED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
  WASTE
  RETURN
  TRANSFER
}

enum BloodUnitStatus {
  AVAILABLE
  RESERVED
  ISSUED
  EXPIRED
  DISCARDED
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRY
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
  EXPIRED
}

enum PharmacyShiftStatus {
  OPEN
  CLOSED
}

enum ConsentStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
}

enum JobApplicationStatus {
  RECEIVED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════════════════════════════════

model Hospital {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  nameBn          String?
  address         String?
  addressBn       String?
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  timezone        String   @default("Asia/Dhaka")
  currency        String   @default("BDT")
  uhidPrefix      String   @default("AV")
  fiscalYearStart Int      @default(7) // July
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  branches       Branch[]
  departments    Department[]
  users          User[]
  patients       Patient[]
  wards          Ward[]
  configs        SystemConfig[]
  employees      Employee[]
  inventoryItems InventoryItem[]
  bloodDonors    BloodDonor[]

  @@map("hospitals")
}

model Branch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String   @db.Uuid
  name       String
  nameBn     String?
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("branches")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  displayName String
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId          String     @db.Uuid
  roleId              String     @db.Uuid
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean    @default(false)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  locale              String     @default("en")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdBy           String?
  updatedBy           String?

  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  mfaSecret     MfaSecret?
  doctorProfile DoctorProfile?
  employee      Employee?
  auditLogs     AuditLog[]

  @@index([hospitalId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MfaSecret {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @db.Uuid
  secret    String
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

// ═══════════════════════════════════════════════════════════════════════════
// ORGANIZATION
// ═══════════════════════════════════════════════════════════════════════════

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId  String   @db.Uuid
  name        String
  nameBn      String?
  code        String?
  description String?
  headUserId  String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  hospital  Hospital        @relation(fields: [hospitalId], references: [id])
  doctors   DoctorProfile[]
  employees Employee[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@map("departments")
}

model SystemConfig {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String   @db.Uuid
  key        String
  value      String
  dataType   String   @default("string")
  category   String   @default("general")
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, key])
  @@index([hospitalId])
  @@map("system_configs")
}

// ═══════════════════════════════════════════════════════════════════════════
// PATIENT
// ═══════════════════════════════════════════════════════════════════════════

model Patient {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId   String      @db.Uuid
  uhid         String      @unique
  firstName    String
  lastName     String
  firstNameBn  String?
  lastNameBn   String?
  dateOfBirth  DateTime
  gender       Gender
  bloodGroup   BloodGroup?
  phone        String
  email        String?
  address      String?
  addressBn    String?
  nidEncrypted String? // pgcrypto encrypted
  photoUrl     String?
  isActive     Boolean     @default(true)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?
  updatedBy    String?

  hospital          Hospital           @relation(fields: [hospitalId], references: [id])
  allergies         PatientAllergy[]
  emergencyContacts EmergencyContact[]
  documents         PatientDocument[]
  appointments      Appointment[]
  visits            Visit[]
  bills             Bill[]
  admissions        Admission[]
  consents          PatientConsent[]
  feedbacks         PatientFeedback[]
  followUps         FollowUpSchedule[]

  @@index([hospitalId])
  @@index([phone])
  @@index([uhid])
  @@map("patients")
}

model PatientAllergy {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String   @db.Uuid
  patientId  String   @db.Uuid
  allergen   String
  reaction   String?
  severity   String   @default("MODERATE")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_allergies")
}

model EmergencyContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId   String   @db.Uuid
  patientId    String   @db.Uuid
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model PatientDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId  String   @db.Uuid
  patientId   String   @db.Uuid
  name        String
  fileUrl     String
  fileType    String
  fileSizeKb  Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCTOR
// ═══════════════════════════════════════════════════════════════════════════

model DoctorProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId      String   @db.Uuid
  userId          String   @unique @db.Uuid
  departmentId    String   @db.Uuid
  bmdcNumber      String?
  specialization  String?
  qualification   String?
  experience      Int?
  bio             String?
  bioBn           String?
  consultationFee Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  user         User             @relation(fields: [userId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  schedules    DoctorSchedule[]
  appointments Appointment[]
  fees         DoctorFee[]

  @@index([hospitalId])
  @@map("doctor_profiles")
}

model DoctorSchedule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId      String   @db.Uuid
  doctorId        String   @db.Uuid
  dayOfWeek       Int // 0=Sunday ... 6=Saturday
  startTime       String // "09:00"
  endTime         String // "17:00"
  slotDurationMin Int      @default(15)
  maxPatients     Int      @default(20)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}

model DoctorFee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId   String   @db.Uuid
  doctorId     String   @db.Uuid
  departmentId String   @db.Uuid
  feeType      String   @default("CONSULTATION")
  amount       Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_fees")
}

// ═══════════════════════════════════════════════════════════════════════════
// SCHEDULING / APPOINTMENT / QUEUE
// ═══════════════════════════════════════════════════════════════════════════

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId     String            @db.Uuid
  patientId      String            @db.Uuid
  doctorId       String            @db.Uuid
  departmentId   String            @db.Uuid
  type           AppointmentType   @default(SCHEDULED)
  status         AppointmentStatus @default(BOOKED)
  scheduledDate  DateTime
  slotStartTime  String?
  slotEndTime    String?
  tokenNumber    String?
  chiefComplaint String?
  cancelReason   String?
  checkedInAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?

  patient    Patient       @relation(fields: [patientId], references: [id])
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id])
  queueToken QueueToken?
  visit      Visit?

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledDate])
  @@map("appointments")
}

model QueueToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId    String    @db.Uuid
  appointmentId String    @unique @db.Uuid
  tokenNumber   String
  displayLabel  String
  estimatedWait Int? // minutes
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("queue_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLINICAL — VISIT / EMR
// ═══════════════════════════════════════════════════════════════════════════

model Visit {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId     String    @db.Uuid
  patientId      String    @db.Uuid
  appointmentId  String?   @unique @db.Uuid
  doctorId       String    @db.Uuid
  departmentId   String    @db.Uuid
  visitDate      DateTime  @default(now())
  chiefComplaint String?
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  deletedAt      DateTime? // soft delete for clinical retention
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  patient       Patient          @relation(fields: [patientId], references: [id])
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  diagnoses     Diagnosis[]
  notes         ClinicalNote[]
  vitals        VitalSign[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  radOrders     RadiologyOrder[]
  consents      PatientConsent[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([visitDate])
  @@map("visits")
}

model Diagnosis {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId  String   @db.Uuid
  visitId     String   @db.Uuid
  icd10Code   String?
  icd10Desc   String?
  description String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model ClinicalNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String   @db.Uuid
  visitId    String   @db.Uuid
  noteType   String   @default("SOAP")
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("clinical_notes")
}

model VitalSign {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId      String   @db.Uuid
  visitId         String?  @db.Uuid
  admissionId     String?  @db.Uuid
  systolicBp      Int?
  diastolicBp     Int?
  heartRate       Int?
  temperature     Decimal? @db.Decimal(5, 2)
  spo2            Int?
  respiratoryRate Int?
  weightKg        Decimal? @db.Decimal(6, 2)
  heightCm        Decimal? @db.Decimal(6, 2)
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  visit     Visit?     @relation(fields: [visitId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])

  @@map("vital_signs")
}

model ICD10Code {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  description   String
  descriptionBn String?
  category      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([code])
  @@map("icd10_codes")
}

// ═══════════════════════════════════════════════════════════════════════════
// PRESCRIPTION
// ═══════════════════════════════════════════════════════════════════════════

model Medicine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId   String   @db.Uuid
  genericName  String
  brandName    String?
  category     String
  dosageForm   String // tablet, capsule, syrup, injection
  strength     String?
  manufacturer String?
  unitPrice    Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  prescriptionItems PrescriptionItem[]
  dispenseItems     PharmacyDispenseItem[]
  stockBatches      StockBatch[]
  drugInteractions  DrugInteraction[]      @relation("DrugA")
  interactsWith     DrugInteraction[]      @relation("DrugB")

  @@index([hospitalId])
  @@index([genericName])
  @@map("medicines")
}

model DrugInteraction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drugAId     String   @db.Uuid
  drugBId     String   @db.Uuid
  severity    String   @default("MODERATE") // MINOR, MODERATE, MAJOR
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  drugA Medicine @relation("DrugA", fields: [drugAId], references: [id])
  drugB Medicine @relation("DrugB", fields: [drugBId], references: [id])

  @@unique([drugAId, drugBId])
  @@map("drug_interactions")
}

model Prescription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String             @db.Uuid
  visitId    String             @db.Uuid
  patientId  String             @db.Uuid
  doctorId   String             @db.Uuid
  status     PrescriptionStatus @default(ACTIVE)
  notes      String?
  validUntil DateTime?
  deletedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  createdBy  String?
  updatedBy  String?

  visit     Visit              @relation(fields: [visitId], references: [id])
  items     PrescriptionItem[]
  dispenses PharmacyDispense[]

  @@index([hospitalId])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId     String   @db.Uuid
  prescriptionId String   @db.Uuid
  medicineId     String   @db.Uuid
  dosage         String
  frequency      String
  duration       String
  route          String   @default("ORAL")
  instructions   String?
  qty            Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("prescription_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// LABORATORY
// ═══════════════════════════════════════════════════════════════════════════

model LabTest {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId        String   @db.Uuid
  name              String
  nameBn            String?
  code              String?
  category          String
  sampleType        String
  normalRangeMale   String?
  normalRangeFemale String?
  unit              String?
  price             Decimal  @db.Decimal(10, 2)
  turnaroundHrs     Int      @default(24)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  labOrderItems LabOrderItem[]

  @@index([hospitalId])
  @@map("lab_tests")
}

model LabOrder {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String         @db.Uuid
  visitId    String         @db.Uuid
  patientId  String         @db.Uuid
  doctorId   String         @db.Uuid
  status     LabOrderStatus @default(PENDING)
